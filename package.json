{
  "name": "resume-copilot",
  "version": "0.2.0",
  "private": true,
  "description": "Interactive resume tailoring, job search, and application tracker powered by Claude + the ResumeSkills skill set. Runs on Cloudflare Workers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:skills": "node scripts/build-skills.mjs",
    "lint": "eslint .",
    "predev": "npm run build:skills",
    "dev": "wrangler dev",
    "predeploy": "npm run build:skills",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create resume-copilot",
    "db:init": "wrangler d1 execute resume-copilot --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute resume-copilot --local --file=./schema.sql",
    "db:reset:local": "wrangler d1 execute resume-copilot --local --command=\"DELETE FROM chat_messages; DELETE FROM documents; DELETE FROM applications; DELETE FROM cvs; DELETE FROM profile;\"",
    "r2:create": "wrangler r2 bucket create resume-copilot-originals",
    "prebuild": "npm run build:skills",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "docx": "^9.1.0",
    "hono": "^4.13.2",
    "jose": "^6.2.8",
    "mammoth": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "wrangler": "^4.123.0"
  }
}
