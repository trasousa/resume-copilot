{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-copilot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Needed by mammoth (.docx -> text) and docx (text -> .docx), both of which
  // reach for Node built-ins. Verified bundling under this flag.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Static frontend. Served by the same Worker as the API, so there is no
  // second deploy and no cross-origin config.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every nav link in public/ is an explicit *.html path. Without this,
    // the default tidy-URL behaviour 307s /index.html -> /index, so each
    // page navigation costs an extra round-trip.
    "html_handling": "none",
    // Unmatched paths fall through to the Worker, which decides between a
    // JSON 404 (for /api/*) and serving index.html.
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resume-copilot",
      // Replace with the id printed by:
      //   npx wrangler d1 create resume-copilot
      "database_id": "f620e648-f023-4174-ae81-1e748d802a0d"
    }
  ],

  // Original uploaded CV files (mammoth only keeps the extracted text).
  // Optional -- routes check for this binding and degrade gracefully if it's
  // absent. Create with: npx wrangler r2 bucket create resume-copilot-originals
  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "resume-copilot-originals"
    }
  ],

  // Per-user agent state (Durable Object, SQLite-backed). One instance per
  // authenticated user, addressed by email -- see src/lib/auth.js
  // (resolveIdentity) and src/index.js for how the instance name is
  // derived server-side, never from a client-supplied URL.
  "durable_objects": {
    "bindings": [{ "name": "RESUME_AGENT", "class_name": "ResumeAgent" }]
  },
  // Never edit an existing migration entry -- add a new tag for future
  // agent classes or storage changes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResumeAgent"] }],

  // Workers AI -- see docs/superpowers/specs/2026-08-16-resume-agent-core-design.md
  // for why (glm-4.7-flash via AI Gateway, replacing Anthropic/Gemini). Not
  // used by this skeleton yet -- wired here so later sub-projects don't need
  // another wrangler.jsonc change.
  "ai": { "binding": "AI" },

  // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD are not secrets -- they only
  // identify which Access application's JWTs this Worker accepts, not a
  // bearer credential. Replace the two placeholders once you've set up the
  // Access application -- see src/lib/auth.js and README.md "Sign-in" (it
  // requires the custom domain below to exist first: Access can't front
  // *.workers.dev). Until they're real, every request fails closed with a
  // 401, which is the correct default, not a bug.
  "vars": {
    // "anthropic" (default) or "gemini" -- see src/lib/llm.js. Whichever is
    // active, only that provider's API key needs to be set as a secret.
    "LLM_PROVIDER": "anthropic",
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "CF_ACCESS_TEAM_DOMAIN": "trasousa.cloudflareaccess.com",
    "CF_ACCESS_AUD": "a55647e511b1d3a8932fb682a628af9901b8eccf2befb5f02aee35779d437c78" // gitleaks:allow -- not a bearer credential, see comment above
  },

  // Required, not cosmetic, now that Access is back: Access can only attach
  // to a real Cloudflare zone, never *.workers.dev. Requires btopencloud.com's
  // DNS to already be on Cloudflare; `wrangler deploy` provisions the custom
  // domain + certificate automatically from this entry -- see README.md
  // "Custom domain" and "Sign-in".
  "routes": [{ "pattern": "resume.btopencloud.com", "custom_domain": true }]

  // Secrets are NOT set here -- they go in the encrypted store:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //   npx wrangler secret put GOOGLE_API_KEY   (only if LLM_PROVIDER is "gemini")
  // For local dev, put the same key(s) in .dev.vars (gitignored). Also set
  // SKIP_AUTH="1" there -- Access never runs in front of `wrangler dev`.
}
