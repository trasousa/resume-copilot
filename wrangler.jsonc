{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-copilot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Needed by mammoth (.docx -> text) and docx (text -> .docx), both of which
  // reach for Node built-ins. Verified bundling under this flag.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Static frontend. Served by the same Worker as the API, so there is no
  // second deploy and no cross-origin config.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every nav link in public/ is an explicit *.html path. Without this,
    // the default tidy-URL behaviour 307s /index.html -> /index, so each
    // page navigation costs an extra round-trip.
    "html_handling": "none",
    // Unmatched paths fall through to the Worker, which decides between a
    // JSON 404 (for /api/*) and serving index.html.
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resume-copilot",
      // Replace with the id printed by:
      //   npx wrangler d1 create resume-copilot
      "database_id": "PLACEHOLDER_RUN_WRANGLER_D1_CREATE"
    }
  ],

  // Original uploaded CV files (mammoth only keeps the extracted text).
  // Optional -- routes check for this binding and degrade gracefully if it's
  // absent. Create with: npx wrangler r2 bucket create resume-copilot-originals
  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "resume-copilot-originals"
    }
  ],

  // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD are not secrets -- they only
  // identify which Access application's JWTs this Worker accepts, not a
  // bearer credential. Replace the two placeholders once you've set up the
  // Access application -- see src/lib/auth.js and README.md "Sign-in" (it
  // requires the custom domain below to exist first: Access can't front
  // *.workers.dev). Until they're real, every request fails closed with a
  // 401, which is the correct default, not a bug.
  "vars": {
    // "anthropic" (default) or "gemini" -- see src/lib/llm.js. Whichever is
    // active, only that provider's API key needs to be set as a secret.
    "LLM_PROVIDER": "anthropic",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "CF_ACCESS_TEAM_DOMAIN": "PLACEHOLDER_YOUR_TEAM.cloudflareaccess.com",
    "CF_ACCESS_AUD": "PLACEHOLDER_AUD_TAG_FROM_ACCESS_APP_OVERVIEW"
  }

  // Secrets are NOT set here -- they go in the encrypted store:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  //   npx wrangler secret put GOOGLE_API_KEY   (only if LLM_PROVIDER is "gemini")
  // For local dev, put the same key(s) in .dev.vars (gitignored). Also set
  // SKIP_AUTH="1" there -- Access never runs in front of `wrangler dev`.
  //
  // To serve this on your own domain instead of *.workers.dev, add a routes
  // entry once the domain is on Cloudflare -- see README.md "Custom domain".
  //   "routes": [{ "pattern": "resume.yourdomain.com", "custom_domain": true }]
}
