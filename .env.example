# No LLM API key needed -- Workers AI authenticates via the "ai" binding in
# wrangler.jsonc alone, which works locally under `wrangler dev` with zero
# extra setup.

# Required for local dev only -- Cloudflare Access never runs in front of
# `wrangler dev`, so this bypasses auth locally. Never set in production.
SKIP_AUTH=1

# Optional overrides
PORT=4173
WORKERS_AI_MODEL=@cf/zai-org/glm-4.7-flash
WORKERS_AI_CHAT_MODEL=@cf/zai-org/glm-4.7-flash

# Optional -- enables the JSearch job source (LinkedIn/Indeed/Glassdoor/
# ZipRecruiter via Google for Jobs). Free tier: 200 requests/month. Get a
# key at https://www.openwebninja.com. This is a real secret -- never put
# the actual value in wrangler.jsonc; use `npx wrangler secret put
# OPENWEBNINJA_API_KEY` for production, and set it here only for local dev
# (.env.example itself is never a real secret's home -- copy this file to
# .dev.vars, which is gitignored, and put the real key there).
OPENWEBNINJA_API_KEY=

# Optional -- Tavily web search as a job source. Get a key at
# https://tavily.com. Same rule as above: real value goes in .dev.vars
# locally, and `npx wrangler secret put TAVILY_API_KEY` for production.
TAVILY_API_KEY=

# Optional -- point the freehire source at a self-hosted backend
# (strelov1/freehire) instead of https://freehire.me. Leave empty to use
# the hosted one; freehire needs no key either way.
FREEHIRE_API_URL=

# Optional -- set to 1 to enable the LinkedIn job source. It needs no key,
# but automated access is against LinkedIn's Terms of Service, so it is off
# unless you turn it on deliberately, for personal low-volume use only.
# See README.md "Job search".
LINKEDIN_SEARCH=

